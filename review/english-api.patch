-"""Transcribe bryophyte herbarium labels (PO / LISU) with Claude and deliver Excel + review PDF.
-
-  lote        --fotos DIR [--pdf]                                (standard run: transcribe new photos, Excel, zip)
-  transcrever --fotos DIR --saida DIR [--limite N] [--amostra]   (calls the API; one JSON per photo)
-  relatorio   --fotos DIR --saida DIR                            (no API: builds the .xlsx and .pdf)
-
-Originals are never modified; rotation is applied only to the copies shown in Excel/PDF.
-"""
-import argparse
-import os
-from typing import Literal
